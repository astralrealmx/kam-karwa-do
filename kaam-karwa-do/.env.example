# =========================================
# KAAM KARWA DO — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# =========================================

# ---- Database (PostgreSQL) ----
# Example (local): postgresql://user:password@localhost:5432/kaamkarwado
# Example (Vercel Postgres / Neon / Supabase): use the connection string they provide
DATABASE_URL="postgresql://user:password@localhost:5432/kaamkarwado"

# ---- App ----
# Base URL of the deployed app (used for absolute links, metadata, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Google Maps ----
# Public key: restricted to your domain(s), used client-side for Maps JS, Places
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-browser-key"
# Server-only key: used for server-side Geocoding/Places calls if needed. Never expose to client.
GOOGLE_MAPS_SERVER_API_KEY="your-google-maps-server-key"

# ---- Auth (foundation only — wired up in a later phase) ----
AUTH_SECRET="replace-with-a-long-random-string"

# ---- Misc ----
NODE_ENV="development"
